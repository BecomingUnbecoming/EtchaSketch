<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EtchaSketch.UI.ViewModels"
             x:Class="EtchaSketch.UI.Views.ThingsImportView"
             x:DataType="vm:ThingsImportViewModel">
    <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="8">
            <TextBlock Text="Import things" FontWeight="SemiBold" />
            <TextBlock Text="From" />
            <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch" />

            <StackPanel Spacing="8" IsVisible="{Binding IsLubeLogger}">
                <TextBlock Text="Into which vehicle" />
                <TextBlock Text="There's no vehicle yet. Add it on the Things tab and tick &quot;It's a vehicle&quot;." TextWrapping="Wrap" Opacity="0.8"
                           IsVisible="{Binding HasNoVehicles}" />
                <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding Vehicle}" HorizontalAlignment="Stretch" IsVisible="{Binding !HasNoVehicles}" />
                <TextBlock Text="The file holds" />
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="A fuel file is recognised by itself" />
            </StackPanel>

            <WrapPanel>
                <Button Content="Choose the file" Click="ChooseFile_Click" Margin="0,0,8,8" />
                <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="0,0,8,8"
                           IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check the file" Command="{Binding PreviewCommand}" />
                <Button Content="Import" Command="{Binding ImportCommand}" Classes="accent" />
                <Button Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                       IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       IsVisible="{Binding Problems, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </Border>
</UserControl>
