<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EtchaSketch.UI.ViewModels"
             x:Class="EtchaSketch.UI.Views.TaskEditorView"
             x:DataType="vm:TaskEditorViewModel">
    <Border MaxWidth="480" Margin="16" Padding="20" CornerRadius="12" VerticalAlignment="Center"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <ScrollViewer>
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" />

                <TextBox Text="{Binding Title}" PlaceholderText="What needs doing?" />
                <TextBox Text="{Binding Notes}" PlaceholderText="Notes (only you can see these)" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="60" IsVisible="{Binding CanEditNotes}" />

                <TextBlock Text="Due" />
                <CalendarDatePicker SelectedDate="{Binding DueDate}" HorizontalAlignment="Stretch"
                                    PlaceholderText="No due date" />

                <StackPanel Spacing="6" IsVisible="{Binding CanHaveTime}">
                    <TextBlock Text="Time (optional)" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TimePicker SelectedTime="{Binding DueTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="With a time, reminders come at that time instead of first thing" />
                        <Button Grid.Column="1" Content="No time" Command="{Binding ClearTimeCommand}" IsVisible="{Binding HasTime}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding MinutesOptions}" SelectedItem="{Binding RemindBefore}" HorizontalAlignment="Stretch"
                              IsVisible="{Binding HasTime}" />
                    <CheckBox Content="Alarm (louder, and comes through quiet hours)" IsChecked="{Binding IsAlarm}"
                              IsVisible="{Binding HasTime}" />
                </StackPanel>

                <TextBlock Text="Remind me" />
                <ComboBox ItemsSource="{Binding ReminderOptions}" SelectedItem="{Binding Reminder}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="You're always reminded on the day it's due" />

                <TextBlock Text="Project" />
                <TextBox Text="{Binding Project}" PlaceholderText="Optional, like Homelab" />

                <TextBlock Text="Labels" />
                <TextBox Text="{Binding LabelsText}" PlaceholderText="Separated by commas, like quick-win, 15min" />

                <TextBlock Text="Priority" />
                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" HorizontalAlignment="Stretch" />

                <CheckBox IsChecked="{Binding IsShared}" Content="Share with the household as a chore" />

                <TextBlock Text="Repeats" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding Repeat}" HorizontalAlignment="Stretch" />
                    <NumericUpDown Grid.Column="1" Value="{Binding RepeatEvery}" Minimum="1" Maximum="365" Increment="1"
                                   FormatString="0" IsVisible="{Binding Repeats}" ToolTip.Tip="Every how many" />
                </Grid>

                <TextBlock Text="Who's doing it" />
                <ComboBox ItemsSource="{Binding AssigneeOptions}" SelectedItem="{Binding Assignee}" HorizontalAlignment="Stretch" />

                <StackPanel Spacing="6" IsVisible="{Binding CanBeStep}">
                    <TextBlock Text="Step of" />
                    <ComboBox ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding Parent}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="Make this a step of a bigger task. It shows indented under it." />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsExisting}">
                    <Separator />
                    <TextBlock Text="Links" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LinkRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Remove" FontSize="12" Command="{Binding RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding LinkKinds}" SelectedItem="{Binding NewLinkKind}" Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding LinkTargets}" SelectedItem="{Binding NewLinkTarget}" PlaceholderText="Choose a task"
                                  MinWidth="180" Margin="0,0,8,8" />
                        <Button Content="Add link" Command="{Binding AddLinkCommand}" Margin="0,0,0,8" />
                    </WrapPanel>

                    <Separator />
                    <TextBlock Text="Comments" FontWeight="SemiBold" />
                    <TextBlock Text="Everyone who can see this task can read its comments." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Comments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommentRowViewModel">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Byline}" FontSize="12" Opacity="0.7" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding NewComment}" PlaceholderText="Add a comment" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" />
                    <Button Content="Add comment" Command="{Binding AddCommentCommand}" HorizontalAlignment="Right" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
