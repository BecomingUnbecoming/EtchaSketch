<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EtchaSketch.UI.ViewModels"
             x:Class="EtchaSketch.UI.Views.MealsView"
             x:DataType="vm:MealsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.cooked">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="10" Margin="0,8,0,0">
            <Border Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Plan a meal" FontWeight="SemiBold" />
                    <WrapPanel>
                        <CalendarDatePicker SelectedDate="{Binding PlanDay}" Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding MealKinds}" SelectedItem="{Binding PlanMeal}" Margin="0,0,8,8" />
                        <ComboBox ItemsSource="{Binding RecipeChoices}" SelectedItem="{Binding PlanRecipe}" MinWidth="200" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBox Text="{Binding PlanTitle}" PlaceholderText="What's planned, like Takeaway" IsVisible="{Binding NeedsTitle}" />
                    <Button Content="Plan it" Command="{Binding PlanCommand}" Classes="accent" />
                    <TextBlock Text="Planning a recipe puts whatever isn't in the pantry on the shopping list." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ItemsControl ItemsSource="{Binding Week}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayMealsViewModel">
                        <StackPanel Spacing="4" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Day}" FontWeight="SemiBold" />
                            <TextBlock Text="Nothing planned" FontSize="12" Opacity="0.6" IsVisible="{Binding IsEmpty}" />
                            <ItemsControl ItemsSource="{Binding Meals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MealRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.cooked="{Binding IsCooked}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Button Content="Cooked" FontSize="12" Command="{Binding CookCommand}" IsVisible="{Binding CanCook}"
                                                        ToolTip.Tip="Takes its ingredients out of the pantry" />
                                                <Button Content="Remove" FontSize="12" Command="{Binding RemoveCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Header="Recipes">
                <StackPanel Spacing="8">
                    <ItemsControl ItemsSource="{Binding Recipes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecipeRowViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Content="Edit" Command="{Binding EditCommand}" />
                                        <Button Content="Delete" Command="{Binding DeleteCommand}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Text="{Binding RecipeName}" PlaceholderText="Recipe name" />
                    <NumericUpDown Value="{Binding RecipeServings}" Minimum="1" Maximum="50" FormatString="0" PlaceholderText="Servings" Width="140"
                                   HorizontalAlignment="Left" />
                    <TextBox Text="{Binding RecipeIngredients}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             PlaceholderText="Ingredients, one per line: 200 g rice, 2 eggs, salt" />
                    <TextBox Text="{Binding RecipeInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" PlaceholderText="How to make it (optional)" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding RecipeSaveLabel}" Command="{Binding SaveRecipeCommand}" />
                        <Button Content="Cancel" Command="{Binding CancelRecipeCommand}" IsVisible="{Binding IsEditingRecipe}" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
