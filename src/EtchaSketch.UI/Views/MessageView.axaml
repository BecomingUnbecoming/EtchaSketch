<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EtchaSketch.UI.ViewModels"
             x:Class="EtchaSketch.UI.Views.MessageView"
             x:DataType="vm:MessageViewModel">
    <StackPanel Margin="24" Spacing="12" MaxWidth="480" VerticalAlignment="Center">
        <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
