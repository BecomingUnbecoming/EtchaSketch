<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EtchaSketch.UI.ViewModels"
             x:Class="EtchaSketch.UI.Views.SetupView"
             x:DataType="vm:SetupViewModel">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="420" VerticalAlignment="Center">
            <TextBlock Text="Welcome to EtchaSketch" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Let's set up your household. Everything stays encrypted on this device."
                       TextWrapping="Wrap" />

            <TextBlock Text="Household name" />
            <TextBox Text="{Binding HouseholdName}" />

            <TextBlock Text="Your name" />
            <TextBox Text="{Binding YourName}" PlaceholderText="e.g. Robin" />

            <TextBlock Text="Anyone else at home? (optional)" />
            <TextBox Text="{Binding OtherName}" PlaceholderText="e.g. Kai" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Content="Get started" Command="{Binding CreateCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Classes="accent" />

            <Separator Margin="0,12" />
            <TextBlock Text="Joining a household that already uses EtchaSketch?" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="On one of its devices, open Sync and make a code for yourself. Then enter it here."
                       TextWrapping="Wrap" Opacity="0.7" />

            <TextBlock Text="Sync server address" />
            <TextBox Text="{Binding JoinAddress}" PlaceholderText="http://192.168.1.20:5080" />

            <TextBlock Text="Pairing code" />
            <TextBox Text="{Binding JoinCode}" PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />

            <TextBlock Text="{Binding JoinErrorMessage}" Foreground="#C42B1C" TextWrapping="Wrap"
                       IsVisible="{Binding JoinErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Content="Join household" Command="{Binding JoinCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
