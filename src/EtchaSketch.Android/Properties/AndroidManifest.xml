	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
	<application android:label="EtchaSketch" android:icon="@drawable/Icon" android:usesCleartextTraffic="true" />
</manifest>
