# Copy this file to .env (same folder) and fill it in. .env is never committed.
#
# The household's sync server, as the assistant reaches it.
ASSISTANT_SYNC_SERVER=http://192.168.1.20:5080
# Whose name new tasks, completions and comments are made under (someone in the household).
ASSISTANT_ACT_AS=
# Only if the sync server has a join token. The assistant code carries it too.
SYNC_JOIN_TOKEN=
